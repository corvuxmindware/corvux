<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Apple privacy manifest. Required for App Store submission since 2024-05-01:
  App Store Connect rejects builds that use a "required reason" API without
  declaring the reason here.

  Corvux is local-first and collects nothing, so the data-type / tracking
  arrays are empty. The two accessed-API categories below come from the
  framework layer, not feature code:

    * FileTimestamp (C617.1) — the Tauri fs plugin reads file modification
      times while indexing the roost. Declared per Tauri's iOS guidance.
    * UserDefaults (CA92.1) — WKWebView / wry read NSUserDefaults belonging
      to this app only.

    * DiskSpace (E174.1) — sysinfo::Disks (ai::capability::detect) reads
      free space to decide whether an on-device model download fits; it
      links statfs/fstatfs (seen in `nm -u` of the build-24 binary).

  Re-derive this list from the binary, not from memory: `nm -u` the archived
  app executable and match against Apple's required-reason symbol list.
  The manifest must also be copied INTO the .app — see the Resources entry in
  project.yml / project.pbxproj (guarded by tests/ios_bundle_config.rs).
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
