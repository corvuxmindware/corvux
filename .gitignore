node_modules/
dist/
src-tauri/target/
# Rust build output for every crate (app, corvux-mcp, local plugins)
target/
# Staged Tauri externalBin sidecars (corvux-mcp-<triple>) — build output
# produced by `pnpm sidecar`, per-platform, never committed.
src-tauri/binaries/*
!src-tauri/binaries/.gitignore
*.log
.DS_Store
.env
.env.*
!.env.example

# QA screenshots and logo previews — local dev artifacts
tmp/

# iOS / Xcode transient state — regenerated by `tauri ios build` /
# `tauri ios dev` and every Xcode launch. Never check this in: the
# build dir is hundreds of MB and the swiftpm/xcuserdata files churn
# per-machine.
src-tauri/gen/apple/build/
src-tauri/gen/apple/**/xcuserdata/
src-tauri/gen/apple/**/DerivedData/
src-tauri/gen/apple/**/xcshareddata/swiftpm/configuration/
src-tauri/gen/apple/**/.swiftpm/

# Apple signing credentials (local release flow) — never commit
.env.signing

# MSIX packaging spike — build output + signing cert (.pfx private key),
# ~75MB of binaries. Local-only, never commit. The one exception is the
# Store manifest (product identity + version), which is tracked.
src-tauri/msix-spike/*
!src-tauri/msix-spike/layout/
src-tauri/msix-spike/layout/*
!src-tauri/msix-spike/layout/AppxManifest.xml

# Signing keys and certificates — never commit, wherever they end up.
*.pfx
*.p12
*.p8
*.jks
*.keystore
*.mobileprovision
key.properties

# Test and dev-server output
playwright-report/
test-results/
.vite/

# Tauri plugin per-build Android scaffolding (regenerated on each build)
src-tauri/plugins/*/android/.tauri/
src-tauri/plugins/*/android/.gradle/
src-tauri/plugins/*/android/build/
src-tauri/vendor/*/android/.tauri/
src-tauri/vendor/*/android/build/

# Editor, OS and local AI-tool state
.claude/
.codex/
.idea/
*.iml
*.swp
*.swo
*~
.playwright-mcp/
Thumbs.db
Desktop.ini
